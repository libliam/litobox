+// ============ Tauri 鍛戒护 ============
+
+#[tauri::command]
+pub fn sqlite_list_tables(db_path: String) -> Result<Vec<TableInfo>, String> {
+    let conn = open_db(&db_path)?;
+    // ponytail: 鐢?MAX(rowid) 浼扮畻琛屾暟锛屾瘮 COUNT(*) 蹇紝瀵硅皟璇曡冻澶?+    let mut stmt = conn
+        .prepare("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name")
+        .map_err(|e| e.to_string())?;
+    let table_names: Vec<String> = stmt
+        .query_map([], |row| row.get::<_, String>(0))
+        .map_err(|e| e.to_string())?
+        .filter_map(|r| match r {
+            Ok(name) => Some(name),
+            Err(e) => {
+                eprintln!("[sqlite_viewer] 琛ㄥ悕琛岃鍙栧け璐? {}", e);
+                None
+            }
+        })
+        .collect();
+
+    let mut tables = Vec::new();
+    for name in table_names {
+        // MAX(rowid) 鍦ㄧ┖琛ㄤ笂杩斿洖 NULL锛屽洜姝ゅ彇 Option<i64>锛涗袱灞?unwrap_or 鍗冲搴旀鎯呭舰
+        let row_count: i64 = match conn.query_row(
+            &format!("SELECT MAX(rowid) FROM \"{}\"", name.replace('"', "\"\"")),
+            [],
+            |row| row.get::<_, Option<i64>>(0),
+        ) {
+            Ok(Some(v)) => v,
+            Ok(None) => 0,
+            Err(e) => {
+                eprintln!("[sqlite_viewer] 琛?{} 琛屾暟鏌ヨ澶辫触: {}", name, e);
+                0
+            }
+        };
+        tables.push(TableInfo { name, row_count });
+    }
+    Ok(tables)
+}
+
+#[tauri::command]
+pub fn sqlite_get_schema(db_path: String, table_name: String) -> Result<Vec<ColumnInfo>, String> {
+    let conn = open_db(&db_path)?;
+    let pragma = format!("PRAGMA table_info(\"{}\")", table_name.replace('"', "\"\""));
+    let mut stmt = conn.prepare(&pragma).map_err(|e| e.to_string())?;
+    let columns: Vec<ColumnInfo> = stmt
+        .query_map([], |row| {
+            // PRAGMA table_info 杩斿洖: cid, name, type, notnull, dflt_value, pk
+            let not_null: i32 = row.get(3)?;
+            let pk: i32 = row.get(5)?;
+            let default_val: Option<String> = row.get(4).ok().flatten();
+            Ok(ColumnInfo {
+                name: row.get(1)?,
+                data_type: row.get::<_, String>(2).unwrap_or_default(),
+                not_null: not_null != 0,
+                is_primary_key: pk != 0,
+                default_value: default_val,
+            })
+        })
+        .map_err(|e| e.to_string())?
+        .filter_map(|r| match r {
+            Ok(c) => Some(c),
+            Err(e) => {
+                eprintln!("[sqlite_viewer] schema 琛岃鍙栧け璐? {}", e);
+                None
+            }
+        })
+        .collect();
+    Ok(columns)
+}
+
+/// 鏌ヨ鏍稿績閫昏緫锛堜笉甯?limit 閽冲埗锛岀敱璋冪敤鏂瑰喅瀹氫笂闄愶級
+/// 璋冪敤鏂硅礋璐ｏ細1) 鏍￠獙 SQL 鏄惁涓?SELECT/WITH锛?) 閽冲埗 max_rows 鍒板悎鐞嗕笂闄?+fn execute_query_internal(conn: &Connection, sql: &str, max_rows: usize) -> Result<QueryResult, String> {
+    let start = Instant::now();
+
+    let mut stmt = conn.prepare(sql).map_err(|e| format!("SQL 閿欒: {}", e))?;
+    let column_count = stmt.column_count();
+    let column_names: Vec<String> = stmt
+        .column_names()
+        .iter()
+        .map(|s| s.to_string())
+        .collect();
+
+    let mut rows_iter = stmt.query([]).map_err(|e| format!("鏌ヨ鎵ц澶辫触: {}", e))?;
+    let mut rows = Vec::new();
+    let mut affected_rows = 0;
+    while let Some(row) = rows_iter.next().map_err(|e| e.to_string())? {
+        if rows.len() >= max_rows {
+            break;
+        }
+        let mut row_values = Vec::with_capacity(column_count);
+        for i in 0..column_count {
+            let val = row.get_ref(i).map_err(|e| e.to_string())?;
+            row_values.push(value_to_json(val));
+        }
+        rows.push(row_values);
+        affected_rows += 1;
+    }
+
+    Ok(QueryResult {
+        columns: column_names,
+        rows,
+        affected_rows,
+        execution_ms: start.elapsed().as_millis() as u64,
+    })
+}
+
+#[tauri::command]
+pub fn sqlite_query(
+    db_path: String,
+    sql: String,
+    limit: Option<usize>,
+) -> Result<QueryResult, String> {
+    if !is_select_sql(&sql) {
+        return Err("浠呮敮鎸?SELECT 鎴?WITH 鏌ヨ".to_string());
+    }
+    let conn = open_db(&db_path)?;
+    conn.busy_timeout(std::time::Duration::from_secs(5))
+        .map_err(|e| e.to_string())?;
+    // ponytail: 寮哄埗閽冲埗鍒?1000 涓婇檺锛岄槻姝㈠墠绔紶鍏ュぇ鍊煎鑷村唴瀛樼垎鐐?+    // 鍗囩骇璺緞锛氬闇€鏇村ぇ缁撴灉闆嗭紝搴旇蛋 sqlite_export_csv 娴佸紡瀵煎嚭鑰岄潪 JSON 鐩磋繑
+    let max_rows = limit.unwrap_or(1000).min(1000);
+    execute_query_internal(&conn, &sql, max_rows)
+}
+
+#[tauri::command]
+pub fn sqlite_table_preview(db_path: String, table_name: String) -> Result<QueryResult, String> {
+    let conn = open_db(&db_path)?;
+    let sql = format!("SELECT * FROM \"{}\"", table_name.replace('"', "\"\""));
+    execute_query_internal(&conn, &sql, 100)
+}
+
+#[tauri::command]
+pub fn sqlite_export_csv(
+    db_path: String,
+    sql: String,
+    save_path: String,
+) -> Result<usize, String> {
+    if !is_select_sql(&sql) {
+        return Err("浠呮敮鎸?SELECT 鎴?WITH 鏌ヨ".to_string());
+    }
+    let conn = open_db(&db_path)?;
+    // ponytail: 瀵煎嚭鏀惧鍒?100000 琛岋紝缁曡繃 sqlite_query 鐨?1000 涓婇檺锛?+    // 澶╄姳鏉匡細浠嶄竴娆℃€ц浇鍏ュ唴瀛橈紝瓒呭ぇ鏁版嵁闆嗕細鎾戠垎锛?+    // 鍗囩骇璺緞锛氬闇€ GB 绾у鍑猴紝搴旀敼涓烘祦寮忓啓鍏ワ紙stmt 杩唬鍣ㄧ洿鍐欐枃浠讹紝涓嶇Н鏀?rows锛?+    let result = execute_query_internal(&conn, &sql, 100000)?;
+
+    // UTF-8 BOM锛岃 Excel 姝ｇ‘璇嗗埆涓枃缂栫爜锛堥粯璁ゆ寜 GBK 瑙ｆ瀽浼氫贡鐮侊級
+    let mut csv_content = "\u{FEFF}".to_string();
+    // 琛ㄥご
+    csv_content.push_str(&result.columns.join(","));
+    csv_content.push('\n');
+    // 鏁版嵁琛?+    for row in &result.rows {
+        let line: Vec<String> = row
+            .iter()
+            .map(|v| {
+                match v {
+                    serde_json::Value::Null => String::new(),
+                    serde_json::Value::String(s) => {
+                        // CSV 杞箟锛氬惈閫楀彿/寮曞彿/鎹㈣鐨勭敤鍙屽紩鍙峰寘瑁癸紝鍐呴儴寮曞彿缈诲€?+                        if s.contains(',') || s.contains('"') || s.contains('\n') {
+                            format!("\"{}\"", s.replace('"', "\"\""))
+                        } else {
+                            s.clone()
+                        }
+                    }
+                    other => other.to_string(),
+                }
+            })
+            .collect();
+        csv_content.push_str(&line.join(","));
+        csv_content.push('\n');
+    }
+
+    std::fs::write(&save_path, csv_content.as_bytes())
+        .map_err(|e| format!("鏂囦欢鍐欏叆澶辫触: {}", e))?;
+    Ok(result.rows.len())
+}
