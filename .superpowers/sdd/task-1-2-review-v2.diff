+// ============ 杈呭姪鍑芥暟 ============
+
+/// 浠ュ彧璇绘ā寮忔墦寮€鏁版嵁搴撴枃浠?+fn open_db(path: &str) -> Result<Connection, String> {
+    Connection::open_with_flags(
+        path,
+        OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    )
+    .map_err(|e| format!("鏃犳硶鎵撳紑鏁版嵁搴撴枃浠? {}", e))
+}
+
+/// 灏?rusqlite 鐨勫€艰浆涓?serde_json::Value
+fn value_to_json(value: ValueRef) -> serde_json::Value {
+    match value {
+        ValueRef::Null => serde_json::Value::Null,
+        ValueRef::Integer(i) => serde_json::json!(i),
+        ValueRef::Real(f) => serde_json::json!(f),
+        ValueRef::Text(bytes) => {
+            serde_json::Value::String(String::from_utf8_lossy(bytes).to_string())
+        }
+        ValueRef::Blob(bytes) => {
+            // ponytail: BLOB 杞?hex 瀛楃涓插睍绀猴紝閬垮厤浜岃繘鍒舵暟鎹牬鍧?JSON
+            // 澶╄姳鏉匡細hex 鎴柇鍒板墠 100 瀛楃锛堢害 50 瀛楄妭锛夛紝澶?BLOB 浠呮樉绀哄墠缂€锛?+            //         涓?hex 鍚庝綋绉炕鍊嶏紝MB 绾?BLOB 浼氭樉钁楁斁澶?JSON 浣撶Н
+            // 鍗囩骇璺緞锛氬闇€瀹屾暣 BLOB 鏌ョ湅鎴栦笅杞斤紝搴旀敼涓烘祦寮忓鍑烘垨鍗曠嫭鐨?BLOB 绔偣
+            let hex: String = bytes.iter().map(|b| format!("{:02x}", b)).collect();
+            serde_json::json!(format!("BLOB:{}bytes:{}", bytes.len(), hex.chars().take(100).collect::<String>()))
+        }
+    }
+}
+
+/// 妫€鏌?SQL 鏄惁涓?SELECT 璇彞锛堝彧鍏佽鏌ヨ锛?+fn is_select_sql(sql: &str) -> bool {
+    let trimmed = sql.trim();
+    // ponytail: 绠€鍗曞墠缂€妫€鏌ワ紝瑕嗙洊 SELECT / WITH (CTE)锛汼QLite 涓嶆敮鎸?EXPLAIN 澶栫殑鍏朵粬璇绘搷浣滃叆鍙?+    // 鍗囩骇璺緞锛氬闇€鏇翠弗鏍肩殑璇彞绫诲瀷鏍￠獙锛堥槻姝㈡敞閲婄粫杩囥€佸璇彞娉ㄥ叆锛夛紝搴旀敼鐢?sqlparser-rs 瑙ｆ瀽 AST
+    let upper = trimmed.to_uppercase();
+    upper.starts_with("SELECT") || upper.starts_with("WITH")
+}
